# MeetBridge configuration. Copy to .env (install does this) and adjust.
# Every value can also be set as an environment variable; the environment wins.

# development | test | production. Production refuses to start with unsafe settings.
MB_ENV=development

# Address people use to reach this server. Must be https:// in production:
# browsers only allow camera and microphone on secure origins (or localhost).
MB_PUBLIC_BASE_URL=http://localhost:8080
MB_HOST=0.0.0.0
MB_PORT=8080

# Long random string (at least 32 characters in production), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# When empty, a key is generated once and stored in MB_DATA_DIR/.secret_key.
MB_SECRET_KEY=

# SQLite file by default. For PostgreSQL:
#   MB_DATABASE_URL=postgresql+psycopg://meetbridge:PASSWORD@db-host:5432/meetbridge
# The schema is migrated automatically on start (or: python -m meetbridge.cli migrate).
# MB_DATABASE_URL=sqlite:////absolute/path/to/meetbridge.db
# Generated secret key and backups (default: ./data).
# MB_DATA_DIR=./data

# Accounts
MB_ALLOW_REGISTRATION=true
MB_SESSION_TTL_HOURS=72
# Set to true when served over https so the session cookie is only sent securely.
MB_COOKIE_SECURE=false

# WebRTC ICE servers for browser participants (JSON). Add a TURN server for
# guests behind strict corporate NATs, e.g.:
# MB_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
MB_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# Capacity. Each active bridge runs one headless browser tab (~300-500 MB RAM).
MB_MAX_ACTIVE_BOTS=6
MB_MAX_LINKS_PER_ROOM=6
MB_MAX_PARTICIPANTS_PER_ROOM=12

# Bridge bot behaviour
MB_BOT_DEFAULT_NAME=MeetBridge
MB_BOT_MAX_RETRIES=3
MB_BOT_RETRY_BASE_SECONDS=5
MB_BOT_JOIN_TIMEOUT_SECONDS=90
MB_BOT_ADMISSION_TIMEOUT_SECONDS=600
# '' = bundled Chromium; 'chrome' or 'msedge' to use an installed browser.
MB_BROWSER_CHANNEL=
MB_BROWSER_HEADLESS=true
MB_SUPERVISOR_INTERVAL_SECONDS=3

# Local MockMeet test platform (used by the automated tests). Never enable in production.
MB_ENABLE_MOCK_PROVIDER=false

# Logging
MB_LOG_LEVEL=INFO
MB_LOG_JSON=false
